# Copy this file to ".env" and adjust the settings you need.
# The default judge provider is local Ollama, so API keys are optional.

# DeepEval judge selection: ollama (default) or openai
DEEPEVAL_JUDGE_PROVIDER=ollama
DEEPEVAL_JUDGE_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# RAG runtime selection: ollama (default) or cloud
RAG_PROVIDER=ollama
# RAG_PROVIDER=cloud
# RAG_CLOUD_CHAT_MODEL=claude-sonnet-4-6
# RAG_CLOUD_EMBEDDING_MODEL=text-embedding-3-small

# Pull both local models before running the agents:
# ollama pull qwen2.5:3b
# ollama pull nomic-embed-text

# To use an OpenAI judge instead, set:
# DEEPEVAL_JUDGE_PROVIDER=openai
# DEEPEVAL_JUDGE_MODEL=gpt-4o
# OPENAI_API_KEY=sk-your-key-here

# Optional keys for other agents/integrations
ANTHROPIC_API_KEY=
CONFIDENT_API_KEY=
